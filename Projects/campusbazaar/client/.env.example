# Client-side environment (Vite)
# All values are inlined at build time. Copy to .env.local and restart `npm run dev`.

# API base. Use root-relative path to use Vite's dev-server proxy (default /api → :5000).
# Set to a full https://… URL in production.
VITE_API_URL=/api

# Build metadata (set automatically by CI).
VITE_APP_ENV=development
VITE_BUILD_HASH=dev-local

# Optional: enable Supabase auth. When both vars are set, the auth service
# will route sign-in / sign-up to Supabase instead of the in-memory local store.
# Get these from https://supabase.com/dashboard → Project Settings → API.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
